{
  "branches": [
    "main",
    {
      "name": "beta",
      "channel": "beta",
      "prerelease": true
    },
    {
      "name": "stacks-signers",
      "channel": "stacks-signers",
      "prerelease": true
    }
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i -e '1h;2,$H;$!d;g' -e 's@name = \"lumaLang\"\\nversion = \"[^\"]*\"@name = \"lumaLang\"\\nversion = \"${nextRelease.version}\"@g' Cargo.toml Cargo.lock"
      }
    ],
    "@semantic-release/github",
    "@semantic-release/changelog",
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "components/lumaLang-cli/Cargo.toml",
          "components/lumaLang-cli/Cargo.lock"
        ]
      }
    ]
  ]
}
